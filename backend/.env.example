# ==============================================================================
# Pixcell Backend Environment Variables
# ==============================================================================
# For local development: copy this file to .env and fill in real values.
# For deployment (e.g. Hugging Face Space, Docker, Railway, Render, VPS):
# set this variable in your hosting environment secrets.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API KEY
# ------------------------------------------------------------------------------
# Google Gemini API key used by backend/llm.py to generate diagnostic pathology summaries
# and clinical recommendations from cell detection counts.
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
