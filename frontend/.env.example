# ==============================================================================
# Pixcell Frontend Environment Variables
# ==============================================================================
# For local development: copy this file to .env.local and fill in real values.
# For production (e.g. Vercel, Docker, VPS): configure these in your deployment dashboard.

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (Drizzle & PostgreSQL)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string for Drizzle ORM.
# For Supabase: Use direct connection (port 5432) for running migrations with drizzle-kit.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & STORAGE
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Found under Project Settings > API)
# IMPORTANT: Required at build time because next.config.ts configures image remotePatterns with this URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Public Anon Key (Found under Project Settings > API)
# Safe to expose to the browser; used by @supabase/auth-helpers-nextjs and client components.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Found under Project Settings > API)
# SECRET: NEVER expose this to the browser/client side.
# Used on the server side (Server Actions & API routes) for administrative tasks and bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION DOMAIN (AUTH REDIRECTS)
# ------------------------------------------------------------------------------
# Base URL of the frontend application.
# Used for constructing email confirmation and password reset redirect links.
# Development: http://localhost:3000
# Production: https://your-production-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. LIVEBLOCKS (REAL-TIME COLLABORATION & CANVAS)
# ------------------------------------------------------------------------------
# Secret key from your Liveblocks dashboard (https://liveblocks.io/dashboard/apikeys)
# Used by the /api/liveblocks-auth route to authorize user sessions for shared canvas/tldraw rooms.
LIVEBLOCKS_SECRET_KEY="sk_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. FASTAPI AI / DETECTION BACKEND
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend service (YOLOv8 cell detection & Gemini LLM pathology analysis).
# IMPORTANT: Must include the protocol (http:// or https://) because Next.js API routes parse it with new URL().
# Development (Local FastAPI): http://127.0.0.1:8000
# Production (e.g. Hugging Face Spaces): https://pixcell-ss-pixcell-backend.hf.space
NEXT_PUBLIC_DETECTION_BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
NEXT_PUBLIC_BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
