# ==============================================================================
# Pixcell Frontend Environment Variables
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env.local`
# 2. Follow the step-by-step guides below to retrieve/generate each required key
# 3. For production deployments (e.g. Vercel/Docker), add these in your hosting environment settings

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (Drizzle & PostgreSQL)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Go to Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your project -> Click "Project Settings" (gear icon in sidebar) -> "Database"
# 3. Scroll down to "Connection parameters" / "Connection string" -> Select "URI" tab
# 4. Mode: Choose "Session" (port 6543) or Direct connection (port 6543)
#    (Note: Drizzle Kit migrations require direct connection on port 6543)
# 5. Replace `[YOUR-PASSWORD]` with the database password set during project creation.
#    (If you forgot your password, reset it on that same "Database" settings page)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & STORAGE
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Go to Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your project -> Click "Project Settings" (gear icon) -> "API" (or "Data API")
#
# NEXT_PUBLIC_SUPABASE_URL:
# - Under "Project URL", copy the "URL" field (e.g., https://xxxxxxxxxxxx.supabase.co)
# - Note: Required at build time because next.config.ts configures image remotePatterns with this URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
# - Under "Project API keys", copy the "anon" / "public" key (starts with eyJ...)
# - Safe to expose to browser; handles public client operations and auth sessions.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY:
# - Under "Project API keys", click "Reveal" next to "service_role" key and copy it.
# - IMPORTANT: Keep this SECRET. Never prefix with NEXT_PUBLIC_ or expose to client.
# - Used in server actions and API routes to bypass Row Level Security (RLS) for admin actions.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION DOMAIN (AUTH REDIRECTS)
# ------------------------------------------------------------------------------
# HOW TO SET:
# - For local development: Set to "http://localhost:3000"
# - For production: Set to your live URL, e.g., "https://pixcell.vercel.app" or "https://yourdomain.com"
#
# SUPABASE REDIRECT URL SETUP (IMPORTANT):
# 1. In Supabase Dashboard -> Go to "Authentication" -> "URL Configuration"
# 2. Set "Site URL" to your app URL (e.g. http://localhost:3000 or https://yourdomain.com)
# 3. Add to "Redirect URLs":
#    - http://localhost:3000/**
#    - https://yourdomain.com/**
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. LIVEBLOCKS (REAL-TIME COLLABORATION & CANVAS)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Go to Liveblocks Dashboard: https://liveblocks.io/dashboard
# 2. Sign in / Create an account -> Create a new project (e.g. "Pixcell")
# 3. Navigate to "API Keys" in the left sidebar
# 4. Copy the "Secret key" (starts with `sk_prod_` or `sk_dev_`)
#    (If you need to regenerate, you can click "Roll key" on the Liveblocks dashboard)
LIVEBLOCKS_SECRET_KEY="sk_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. FASTAPI AI / DETECTION BACKEND
# ------------------------------------------------------------------------------
# HOW TO SET:
# - For local development: Run `uvicorn main:app --reload` in /backend and set to "http://127.0.0.1:8000"
# - For production / Hugging Face Spaces: Set to your public Space or server endpoint,
#   e.g. "https://pixcell-ss-pixcell-backend.hf.space"
#
# IMPORTANT: Always include the protocol (`http://` or `https://`) because Next.js routes parse this with `new URL()`.
NEXT_PUBLIC_DETECTION_BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
NEXT_PUBLIC_BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
BACKEND_URL="https://pixcell-ss-pixcell-backend.hf.space"
